<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="localrtsp.App"
    RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush">#282C34</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceBrush">#21252B</SolidColorBrush>
        <SolidColorBrush x:Key="InputBrush">#1D1F23</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#3E4451</SolidColorBrush>
        <SolidColorBrush x:Key="ForegroundBrush">#D7DAE0</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryBrush">#ABB2BF</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#528BFF</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#98C379</SolidColorBrush>
        <SolidColorBrush x:Key="WarningBrush">#E5C07B</SolidColorBrush>
        <SolidColorBrush x:Key="ErrorBrush">#E06C75</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <Style Selector="TextBlock.status.running">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="TextBlock.status.transition">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="16,9" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#101318" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
